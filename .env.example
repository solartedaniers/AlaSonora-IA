INTERNAL_API_KEY=<mismo valor que AI_ENGINE_API_KEY en el .env del backend (repo AlaSonora-Backend)>
DEFAULT_MIN_CONFIDENCE=0.1
DEFAULT_MAX_RESULTS=3
MAX_INFERENCE_WORKERS=2

# false = /classify-photo responde 503 sin cargar torch/transformers (despliegues de 512 MB)
PHOTO_CLASSIFICATION_ENABLED=true

# Opcionales: umbrales de limpieza y calidad de audio (estos son sus valores por defecto)
# AUDIO_HIGHPASS_CUTOFF_HZ=300.0
# AUDIO_NOISE_FLATNESS_THRESHOLD=0.3
# AUDIO_BIRD_BAND_ENERGY_RATIO_THRESHOLD=0.15

# Opcionales: modelo y umbrales de la identificación por foto
# PHOTO_MODEL_ID=dennisjooo/Birds-Classifier-EfficientNetB2
# DEFAULT_PHOTO_MIN_CONFIDENCE=0.3
# DEFAULT_PHOTO_MAX_RESULTS=3
